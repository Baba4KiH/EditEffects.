# Copy to .env. Never publish credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public HTTPS origin, without a path. Leave empty for local testing.
SITE_URL=
# Set true only after completing the actual documents.
LEGAL_READY=false
# Enable only when the public site is ready.
ALLOW_INDEXING=false
# Exact IPs of proxies that OVERWRITE X-Real-IP. Empty for direct local use.
TRUSTED_PROXY_IPS=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
